{
  "_comment": "Example Claude Code hooks for the Sidelight agent widget. Merge the 'hooks' key into ~/.claude/settings.json and replace /path/to/sidelight with your checkout.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/sidelight/scripts/send-event.sh finished",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/sidelight/scripts/send-event.sh waiting \"Needs your input\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
