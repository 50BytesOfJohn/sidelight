{
  "_comment": "Example only - NOT installed. Merge the 'hooks' key into ~/.claude/settings.json yourself to try it.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Desktop/sidepanel-poc/native/scripts/send-event.sh finished",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Desktop/sidepanel-poc/native/scripts/send-event.sh waiting \"Needs your input\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
